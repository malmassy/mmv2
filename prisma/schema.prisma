// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  testResults TestResult[]

  @@map("users")
  @@index([email])
  @@index([isAdmin])
}

model TestResult {
  id                String   @id @default(cuid())
  userId            String?  @map("user_id")
  testId            String?  @map("test_id")
  config            String   // JSON string of TestSetupConfig
  questions         String   // JSON string of Question[]
  answers           String   // JSON string of TestAnswer[]
  gradeResults      String   @map("grade_results") // JSON string of Record<string, GradeResult>
  scoreCorrect      Int      @map("score_correct")
  scoreTotal        Int      @map("score_total")
  startedAt         DateTime @map("started_at")
  submittedAt       DateTime @map("submitted_at")
  totalTimeSpentMs  Int      @map("total_time_spent_ms")
  pausedTimeMs      Int      @map("paused_time_ms")
  phases            String   // JSON string of phases
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  questionAttempts  QuestionAttempt[]

  @@map("test_results")
  @@index([userId])
  @@index([testId])
  @@index([submittedAt])
}

model QuestionAttempt {
  id            String   @id @default(cuid())
  testResultId  String   @map("test_result_id")
  questionId    String   @map("question_id")
  subtype       String
  parentType    String   @map("parent_type") // 'estimation' | 'conversion' | 'measurement'
  submittedAnswer String @map("submitted_answer")
  isCorrect     Boolean  @map("is_correct")
  score         Float
  timeSpentMs   Int      @map("time_spent_ms")
  phase         String   // 'estimation' | 'conversion' | 'measurement'
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  testResult    TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@map("question_attempts")
  @@index([testResultId])
  @@index([subtype])
  @@index([parentType])
  @@index([phase])
  @@index([isCorrect])
}
